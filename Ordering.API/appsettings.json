{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "OrderingConnectionString": "Host=orderingdb;Port=5432;Database=OrderDb;Username=admin;Password=password"
    //"OrderingConnectionString": "Host=localhost;Port=5432;Database=OrderDb;Username=admin;Password=password;SearchPath=public"
  },
  "EventBusSettings": {
    "HostAddress": "amqp://guest:guest@rabbitmq:5672"
    //"HostAddress": "amqp://guest:guest@localhost:5672"
  },
  "AllowedHosts": "*"
}
